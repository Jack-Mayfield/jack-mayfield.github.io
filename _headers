# App cache policy for the Netlify app site (dist/ only — the lab site serves lab/
# and is unaffected; GitHub Pages ignores this file).
#
# HTML, the service worker, and the manifest must always revalidate so a tester
# never gets a stale build after a phase lands. Vite's content-hashed assets are
# immutable and cache forever.

/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
